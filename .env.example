# ---- RPC endpoints (use your own keys) ----
SEPOLIA_RPC_URL=
MAINNET_RPC_URL=

# ---- Deploy key. NEVER commit a real one — use a throwaway hot wallet. ----
# NOTE: this lab ships intentionally vulnerable contracts. Do not deploy them
# to any network holding real value. See the DISCLAIMER in README.md.
PRIVATE_KEY=

# ---- Contract verification ----
ETHERSCAN_API_KEY=

# ---- Optional: reuse an already-deployed Groth16 verifier ----
VERIFIER_ADDRESS=

# ---- Must match the depth hard-coded in withdraw.circom (default 20) ----
MERKLE_TREE_DEPTH=20
