{
  "name": "zk-drain-lab",
  "version": "1.0.0",
  "description": "ZK privacy-pool exploit lab: a Damn-Vulnerable-DeFi-style playground for zero-knowledge bugs. Deliberately broken Tornado-style mixer (nullifier reuse) + the fix + a drain PoC.",
  "author": "Loxee",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/loxlid/zk-drain-lab.git"
  },
  "keywords": [
    "zero-knowledge",
    "zk-snark",
    "groth16",
    "circom",
    "snarkjs",
    "tornado-cash",
    "privacy-pool",
    "nullifier",
    "merkle-tree",
    "poseidon",
    "security",
    "exploit",
    "double-spend"
  ],
  "scripts": {
    "compile": "circom circuits/withdraw.circom --r1cs --wasm --sym -l node_modules -o build",
    "ptau": "bash scripts/build.sh ptau",
    "setup": "bash scripts/build.sh setup",
    "export-verifier": "bash scripts/build.sh verifier",
    "build": "bash scripts/build.sh all",
    "prove": "node scripts/generate-proof.js inputs/input.example.json",
    "verify": "snarkjs groth16 verify build/verification_key.json build/public.json build/proof.json",
    "clean": "rm -rf build"
  },
  "dependencies": {
    "circomlib": "^2.0.5"
  },
  "devDependencies": {
    "circom_tester": "^0.0.20",
    "ffjavascript": "^0.2.63",
    "snarkjs": "^0.7.4"
  },
  "engines": {
    "node": ">=18"
  }
}
